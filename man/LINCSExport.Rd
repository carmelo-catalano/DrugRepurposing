\name{LINCSExport}
\alias{LINCSExport}
\title{Export data from the LINCS GCTX archive GSE92742_Broad_LINCS_Level3_INF_mlr12k_n1319138x12328.gctx to Rds files}
\description{
Export data from the \link{LINCS} GCTX archive GSE92742_Broad_LINCS_Level3_INF_mlr12k_n1319138x12328.gctx to Rds files.
\cr
Operating with Rds files is much faster (over 300 times) than using the GCTX archive.
This class exports the data of a gene into an Rds file.
}
\usage{
lincsExport <- LINCSExport$new(gctx_archive_filename)
lincsExport$export(gene_list, drug_perturbation_times, output_dir, gene_number_batch_size, drugs_filter)
}
\arguments{
  \item{gene_list}{
    List of genes to export.
    \itemize{
      \item Type: \code{vector}.
    }
  }
  \item{drug_perturbation_times}{
    List of drug perturbation times.
    Drug perturbation time is the duration for which the sample is treated with the drug.
    \itemize{
      \item Type: \code{character vector}.
    }
  }
  \item{output_dir}{
    Directory where the exported gene files are saved.
    \itemize{
      \item Type: \code{character}.
    }
  }
  \item{gene_number_batch_size}{
    Number of genes to be exported in each batch.
    \itemize{
      \item Type: \code{integer}.
      \item Default value: \code{200}.
    }
  }
  \item{drugs_filter}{
    List of drug names. If not specified, all drugs are exported; otherwise, only the drugs listed in \code{drugs_filter} are exported.
    \itemize{
      \item Type: \code{string vector}.
      \item Default value: \code{NA}.
    }
  }
  \item{gctx_archive_filename (constructor argument)}{
    The full file path of the GCTX archive.
    \itemize{
      \item Type: \code{character}.
    }
  }
  \item{metadataSetuper (constructor argument)}{
    Class instance to configure LINCS metadata.
    This packaged provides the implementation \code{\link{LINCSMetadataSetuper}}.
    If not specified, the default implementation is \code{\link{LINCSMetadataSetuper}}.
    \itemize{
      \item Type: class derived from \code{\link{LINCSMetadataSetuperAbstract}}.
      \item Default value: Instance of class \code{\link{LINCSMetadataSetuper}}.
    }
  }
}
\value{
A collection of data frames saved as Rds files, where each file corresponds to a single gene.
Each table contains one row, with column names representing experiment IDs and corresponding values indicating gene expression levels.
The file name is generated by concatenating the gene_id and perturbation_time, e.g., \code{780_6h.Rds}.
}
\examples{
gene_list <- c("22", "23", "25", "29")
drug_perturbation_times <- c("6")
output_dir <- "/home/user/lincs_rds"
gene_number_batch_size <- 100
drugs_filter <- c("AM-251", "AM-404", "AM-580")
gctx_archive_filename <- "/home/user/GSE92742_Broad_LINCS_Level3_INF_mlr12k_n1319138x12328.gctx"

lincsExport <- LINCSExport$new(gctx_archive_filename)
lincsExport$export(gene_list, drug_perturbation_times, output_dir, gene_number_batch_size, drugs_filter)
# Example of file content:
# AML001_CD34_24H_X1_F1B10:A03   AML001_CD34_24H_X1_F1B10:A05   AML001_CD34_24H_X1_F1B10:B05   AML001_CD34_24H_X1_F1B10:E03
# -------------------------------------------------------------------------------------------------------------------------
# 108.545                        93.453                         90.266                         92.113
}
