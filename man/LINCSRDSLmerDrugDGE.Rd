\name{LINCSRDSLmerDrugDGE}
\alias{LINCSRDSLmerDrugDGE}
\title{Calculate the differential gene expression (DGE) for a gene list and drug list from the LINCS database}
\description{
Calculate the differential gene expression (DGE) for a gene list and drug list from the LINCS database. The linear mixed model (LMM) is computed using the lmer function (library lme4).
}
\usage{
lincsRDSLmerDrugDGE <- LINCSRDSLmerDrugDGE$new(lincs_splitted_level3_dir, output_DGE_dir, skip_already_computed_genes)
lincsRDSLmerDrugDGE$compute(perturbation_times, gene_list, drugs_filter)
}
\arguments{
  \item{perturbation_times}{
    List of perturbation times.
    \itemize{
      \item Type: \code{string vector}.
    }
  }
  \item{gene_list}{
    List of genes used for DGE computation.
    \itemize{
      \item Type: \code{vector}.
    }
  }
  \item{drugs_filter}{
    List of drugs for which the DGE will be computed.
    \itemize{
      \item Type: \code{vector}.
      \item Default value: \code{NA}.
    }
  }
  \item{lincs_splitted_level3_dir (constructor argument)}{
    Folder containing the RDS files exported from LINCS archive. Each file contains RNA data for a specific gene_id, and its name corresponds to the gene_id.
    \itemize{
      \item Type: \code{string}.
    }
  }
  \item{output_DGE_dir (constructor argument)}{
    The output directory where output DGE files are saved.
    \itemize{
      \item Type: \code{string}.
    }
  }
  \item{skip_already_computed_genes (constructor argument)}{
    If set to true, the DGE computation will be skipped for genes whose output file already exists.
    \itemize{
      \item Type: \code{boolean}.
      \item Default value: \code{F}.
    }
  }
}
\value{
Set of data frame saved as Rds files. Columns: \code{drug, gene_id, DE_log2_FC, std.error, t.value}.
\cr
The file name is generated by concatenating gene_id and perturbation_time (e.g., 780_6h.Rds).
\cr
Lmer does not return a p-value. Therefore, when LMM is computed using lmer, the fields p.value and adj.p.value are not included.
}
\examples{
perturbation_times <- "6"
gene_list <- "780"
drugs_filter <- c("AM-251", "AM-404", "AM-580", "aminoglutethimide", "aminopurvalanol-a")
lincs_splitted_level3_dir <- "/home/user/lincs"
output_DGE_dir <- "/home/user/dge"
skip_already_computed_genes <- TRUE
lincsRDSLmerDrugDGE <- LINCSRDSLmerDrugDGE$new(lincs_splitted_level3_dir, output_DGE_dir, skip_already_computed_genes)
lincsRDSLmerDrugDGE$compute(perturbation_times, gene_list, drugs_filter)
# Output example:
# drug               gene_id   DE_log2_FC    std.error    t.value
# AM-251             780       -0.00983581   0.06666298  -0.1475453
# AM-404             780        0.04360393   0.07309336   0.5965512
# AM-580             780        0.03516204   0.04044605   0.8693566
# aminoglutethimide  780       -0.15632558   0.05934421  -2.6342179
# aminopurvalanol-a  780        0.04617297   0.09279416   0.4975849
}
