\name{LINCSLMMDrugDGE}
\alias{LINCSLMMDrugDGE}
\title{Computes the Differential Gene Expression (DGE) for a specified gene list and drug set from the LINCS database using Linear Mixed Models (LMM)}
\description{
Computes Differential Gene Expression (\link{DGE}) for a specified gene list and drug set from the \link{LINCS} database.
\cr
For each gene and perturbation time, an output file (Rds format) is generated containing the DGE computed between
 the gene and the drugs at that specific perturbation time.
\cr
The output file is named according to the following schema: "geneID"_"drug_perturbation_time".Rds.
\cr
The data are loaded from the LINCS archive GSE92742_Broad_LINCS_Level3_INF_mlr12k_n1319138x12328.gctx.
The associated metadata (extracted from GSE92742_Broad_LINCS_inst_info.txt) are loaded using
the \code{\link{LINCSMetadataSetuper}} class.
\cr
This class serves as the core component of the classes: \code{\link{LINCSGCTXLMMDrugDGELmer}}
\code{\link{LINCSRDSLMMDrugDGEJulia}}, and \code{\link{LINCSRDSLMMDrugDGELmer}}.
\cr
The DGE computation is based on a Linear Mixed Model (LMM).
}
\usage{
lincsLMMDrugDGE <- LINCSLMMDrugDGE$new(metadataSetuper, lincsDataLoader, lmmDGEByGene, output_DGE_dir, skip_already_computed_genes)
lincsLMMDrugDGE$compute(drug_perturbation_times, gene_list, drugs_filter)
}
\arguments{
  \item{drug_perturbation_times}{
    List of drug perturbation times.
    Drug perturbation time is the duration for which the sample is treated with the drug.
    \itemize{
      \item Type: \code{character vector}.
    }
  }
  \item{gene_list}{
    List of genes used for DGE computation.
    \itemize{
      \item Type: \code{vector}.
    }
  }
  \item{drugs_filter}{
    List of drugs for which the DGE will be computed.
    \itemize{
      \item Type: \code{vector}.
      \item Default value: \code{NA}.
    }
  }
  \item{metadataSetuper (constructor argument)}{
    Class instance to configure LINCS metadata.
    This packaged provides the implementation \code{\link{LINCSMetadataSetuper}}.
    If not specified, the default implementation is \code{LINCSMetadataSetuper}.
    \itemize{
      \item Type: class derived from \code{\link{LINCSMetadataSetuperAbstract}}.
    }
  }
  \item{lincsDataLoader (constructor argument)}{
    Class instance for loading RNA gene expression from LINCS archive. This package provides the implementations \code{LINCSRDSDataLoader} and \code{LINCSGCTXDataLoader}.
    \itemize{
      \item Type: class derived from \code{\link{LMMFormatDataLoaderAbstract}}.
    }
  }
  \item{lmmDGEByGene (constructor argument)}{
    Instance of class \code{\link{LMMDGEByGene}}.
    \itemize{
      \item Type: \code{class}.
    }
  }
  \item{output_DGE_dir (constructor argument)}{
    The output directory where output DGE files are saved.
    \itemize{
      \item Type: \code{string}.
    }
  }
  \item{skip_already_computed_genes (constructor argument)}{
    If set to \code{TRUE}, the \link{DGE} computation will be skipped for genes whose output file already exists.
    \itemize{
      \item Type: \code{boolean}.
      \item Default value: \code{FALSE}.
    }
  }
}
\value{
Set of data frames saved as Rds files. Columns: \code{drug}, \code{gene_id}, \code{DE_log2_FC}, \code{std.error}, \code{t.value}, \code{p.value}, \code{adj.p.value}.
The file name is generated by concatenating \code{gene_id} and \code{perturbation_time}, e.g., \code{780_6h.Rds}.
\code{lmer} does not return a p-value. Therefore, when LMM is computed using \code{lmer}, the fields \code{p.value} and \code{adj.p.value} are not included.
}
\examples{
drug_perturbation_times <- "6h"
gene_list <- "780"
drug_filter <- c("AM-251", "AM-404", "AM-580")
lincs_splitted_level3_dir <- "/home/user/lincs_rds"
output_DGE_dir <- "/home/user/dge"
skip_already_computed_genes <- TRUE

lincsMetadataSetuper <- LINCSMetadataSetuper$new()
lincsRDSDataLoader <- LINCSRDSDataLoader$new(lincs_splitted_level3_dir)
lmmDGEByGene <- LMMDGEByGene$new(LINCSLMMJulia$new(), LMMJuliaToDataFrameMapper$new())
lincsLMMDrugDGE <- LINCSLMMDrugDGE$new(metadataSetuper, lincsDataLoader, lmmDGEByGene, output_DGE_dir, skip_already_computed_genes)
lincsLMMDrugDGE$compute(drug_perturbation_times, gene_list, drugs_filter)
# Output:
# drug             gene_id   DE_log2_FC   std.error   t.value      p.value      adj.p.value
# AM-251           780       -0.047038    0.073635    -0.638804    0.5229501    0.6536876
# AM-404           780       -0.199576    0.071673    -2.784521    0.0053606    0.0268034
# AM-580           780        0.051220    0.055126     0.929161    0.3528054    0.5880090
}
