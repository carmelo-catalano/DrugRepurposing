\name{LINCSRDSLMMDrugDGEJuliaClusters}
\alias{LINCSRDSLMMDrugDGEJuliaClusters}
\title{Calculate the differential gene expression (DGE) for a gene list and drug list from the \code{LINCS} database}
\description{
Calculate the differential gene expression (DGE) for a gene list and drug list from the \link{LINCS} database.
The linear mixed model (LMM) is computed using the \code{Julia} environment.
Multiple parallel DGE computations are implemented using the \code{clusterApply} function.
The input is divided into chunks, and this class creates a cluster for each chunk.
The computation for each chunk is performed by \code{LINCSRDSJuliaDrugDGE}.
\cr
To use this function, the \code{Julia} environment must be installed on the system.
}
\usage{
lincsRDSLMMDrugDGEJuliaClusters <- LINCSRDSLMMDrugDGEJuliaClusters$new(lincs_splitted_level3_dir, output_DGE_dir, cluster_start_delay, BLAS_num_threads, skip_already_computed_genes)
lincsRDSLMMDrugDGEJuliaClusters$compute(chunks)
}
\arguments{
  \item{chunks}{
    List of chunks. Each chunk is a list containing the necessary data to invoke the
    \code{compute} function of the \code{LINCSRDSJuliaDrugDGE} class.
    \cr
    The chunk items are: drug_perturbation_times, gene_list, drugs_filter, and number.
    \cr
    number is a label to identify the chunk.
    \cr
    See example below.
    \itemize{
      \item Type: \code{list}.
    }
  }
  \item{gene_list}{
    List of genes used for DGE computation.
    \itemize{
      \item Type: \code{vector}.
    }
  }
  \item{drugs_filter}{
    List of drugs for which the DGE will be computed.
    \itemize{
      \item Type: \code{vector}.
      \item Default value: \code{NA}.
    }
  }
  \item{lincs_splitted_level3_dir (constructor argument)}{
    Folder containing the RDS files exported from LINCS archive.
    Each file contains RNA data for a specific gene_id, and its name corresponds to the gene_id.
    \itemize{
      \item Type: \code{character}.
    }
  }
  \item{output_DGE_dir (constructor argument)}{
    The output directory where output DGE files are saved.
    \itemize{
      \item Type: \code{character}.
    }
  }
  \item{cluster_start_delay (constructor argument)}{
    The time, in seconds, to wait before initiating the creation of a new cluster. Simultaneous cluster creation may lead to system freezes.
    \itemize{
      \item Type: \code{integer}.
      \item Default value: \code{40}.
    }
  }
  \item{BLAS_num_threads (constructor argument)}{
    Threads number for parallel computation through \code{Julia} \code{LinearAlgebra.BLAS} module.
    \itemize{
      \item Type: \code{integer}.
      \item Default value: \code{processorCores$getJuliaCores()}.
    }
  }
  \item{skip_already_computed_genes (constructor argument)}{
    If set to \code{TRUE}, the \link{DGE} computation will be skipped for genes whose output file already exists.
    \itemize{
      \item Type: \code{boolean}.
      \item Default value: \code{FALSE}.
    }
  }
}
\value{
Set of data frame saved as Rds files. Columns: drug, gene_id, DE_log2_FC, std.error, t.value, p.value, adj.p.value. The file name is generated by concatenating gene_id and perturbation_time (e.g., 780_6h.Rds).
}
\examples{
chunk1 <- list()
chunk1$perturbation_times <- "6"
chunk1$gene_list <- c(140, 780)
chunk1$drugs_filter <- c("AM-92016", "AMG-9810", "AMN-082")
chunk1$number <- 1
chunk2 <- list()
chunk2$perturbation_times <- "24"
chunk2$gene_list <- c(140, 780)
chunk2$drugs_filter <- c("AM-92016", "AMG-9810", "AMN-082")
chunk2$number <- 2
chunks <- list()
chunks[[1]] <- chunk1
chunks[[2]] <- chunk2
lincs_splitted_level3_dir <- "/home/user/lincs"
output_DGE_dir <- "/home/user/dge"
cluster_start_delay <- 15
BLAS_num_threads <- 5
skip_already_computed_genes <- T
lincsRDSLMMDrugDGEJuliaClusters <- LINCSRDSLMMDrugDGEJuliaClusters$new(lincs_splitted_level3_dir, output_DGE_dir, cluster_start_delay, BLAS_num_threads, skip_already_computed_genes)
lincsRDSLMMDrugDGEJuliaClusters$compute(chunks)

# Output example:
# drug               gene_id   DE_log2_FC   std.error   t.value   p.value   adj.p.value
# -------------------------------------------------------------------------------------
# AM-251             780       -0.047038    0.073635    -0.639    0.523     0.653
# AM-404             780       -0.199576    0.071673    -2.785    0.00536   0.0268
# AM-580             780        0.051221    0.055126     0.929    0.353     0.588
# aminoglutethimide  780        0.004159    0.070087     0.0593   0.953     0.953
# aminopurvalanol-a  780        0.088157    0.092338     0.955    0.340     0.588
}
